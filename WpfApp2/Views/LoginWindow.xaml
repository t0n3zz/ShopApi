<Window x:Class="Marketplace.App.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Вход" Height="420" Width="350" WindowStartupLocation="CenterScreen">
    <StackPanel Margin="30" VerticalAlignment="Center">
        <TextBlock Text="GMWOG Маркет" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>

        <TextBlock Text="Логин:"/>
        <TextBox x:Name="LoginBox" Margin="0,0,0,10" Padding="5"/>

        <TextBlock Text="Пароль:"/>
        <PasswordBox x:Name="PasswordBox" Margin="0,0,0,10" Padding="5"/>

        <TextBlock Text="Повтор пароля:"/>
        <PasswordBox x:Name="RepeatPasswordBox" Margin="0,0,0,15" Padding="5"/>

        <Button Content="Войти" Click="Login_Click" Padding="10" Margin="0,0,0,5" Background="#2275D7" Foreground="White"/>
        <Button Content="Зарегистрироваться" Click="Register_Click" Padding="10" Margin="0,0,0,5"/>
        <Button Content="Продолжить как гость" Click="Guest_Click" Padding="10"/>

        <TextBlock x:Name="MessageText" Foreground="Red" TextWrapping="Wrap" Margin="0,15,0,0"/>
    </StackPanel>
</Window>