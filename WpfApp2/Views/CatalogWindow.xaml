<Window x:Class="Marketplace.App.Views.CatalogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Каталог товаров" Height="700" Width="1000" WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <Button Content="🛒 Корзина" DockPanel.Dock="Right" Click="OpenCart_Click" Padding="10,5" Margin="5,0"/>
            <Button Content="Выйти" DockPanel.Dock="Right" Click="Logout_Click" Padding="10,5" Margin="5,0"/>
            <TextBlock x:Name="UserInfo" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="10,0" FontWeight="Bold"/>
            <TextBlock Text="Каталог" FontSize="22" FontWeight="Bold"/>
        </DockPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Поиск:" VerticalAlignment="Center"/>
            <TextBox x:Name="SearchBox" Width="200" Margin="5,0" Padding="3"/>
            <TextBlock Text="Категория:" VerticalAlignment="Center" Margin="10,0,0,0"/>
            <ComboBox x:Name="CategoryCombo" Width="150" Margin="5,0" DisplayMemberPath="Name" SelectedValuePath="Id"/>
            <Button Content="Найти" Click="Search_Click" Padding="15,3" Margin="10,0,0,0"/>
        </StackPanel>

        <ListBox x:Name="ProductsList" Grid.Row="2" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="LightGray" BorderThickness="1" Padding="10" Margin="5" CornerRadius="5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="150"/>
                            </Grid.ColumnDefinitions>

                            <Image Source="{Binding ImagePath}" Grid.Column="0" Width="90" Height="90" Stretch="Uniform"/>

                            <StackPanel Grid.Column="1" Margin="10,0">
                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="16"/>
                                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" MaxHeight="40" Foreground="Gray"/>
                                <TextBlock Text="{Binding Price, StringFormat='Цена: {0:C}'}" FontWeight="Bold" Foreground="Green" FontSize="14"/>
                                <TextBlock Text="{Binding AverageRating, StringFormat='Оценка: {0:F1}/5'}" Foreground="Orange"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <Button Content="В корзину" Click="AddToCart_Click" Tag="{Binding Id}" Margin="0,0,0,5" Padding="5"/>
                                <Button Content="Подробнее" Click="Details_Click" Tag="{Binding Id}" Padding="5"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Window>